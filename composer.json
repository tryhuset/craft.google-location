{
  "name": "apt/craft-google-location",
  "description": "Select location in google map",
  "type": "craft-plugin",
  "version": "3.0.0",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "craft google location"
  ],
  "support": {
    "docs": "https://git1.apt.no/open/craft-google-location/blob/master/README.md",
    "issues": "https://git1.apt.no/open/craft-google-location/issues"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Thomas Sømoen",
      "homepage": "https://apt.no/"
    }
  ],
  "repositories": [
    {
      "type": "vcs",
      "url": "https://git1.apt.no/open/craft-countries-module.git"
    }
  ],
  "require": {
    "php": ">=8.2",
    "craftcms/cms": "^5.0",
    "apt/craft-countries-module": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "apt\\craftgooglelocation\\": "src/"
    }
  },
  "extra": {
    "name": "Google Location",
    "handle": "google-location",
    "hasCpSettings": true,
    "hasCpSection": false,
    "changelogUrl": "https://git1.apt.no/open/craft-google-location",
    "components": {
      "content": "apt\\craftgooglelocation\\services\\Content"
    },
    "class": "apt\\craftgooglelocation\\CraftGoogleLocation"
  },
  "require-dev": {
    "craftcms/rector": "dev-main"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true,
      "craftcms/generator": true
    }
  }
}
