{% import "_includes/forms" as forms %}

{#% do view.registerAssetBundle("apt\\craftgooglelocation\\assetbundles\\locationfield\\LocationFieldAsset") %#}

{{ forms.textField({
        label: 'Some Field',
        instructions: 'Enter some text here.',
        id: name~'_lat',
        name: name~'[lat]',
        value: value.lat
})}}

{{ forms.textField({
        label: 'Some Field',
        instructions: 'Enter some text here.',
        id: name~'_lng',
        name: name~'[lng]',
        value: value.lng
})}}

<div id="apt-google-location-map"></div>

<script>
    function AptCraftGoogleLocationInitMap() {
        console.log('HEPP2');
        $('body').trigger('apt-google-location-map-init');
        // $('#apt-google-location-map').craftGoogleLocationMap();
    }
</script>
