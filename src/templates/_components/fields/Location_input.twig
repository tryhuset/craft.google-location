{% import "_includes/forms" as forms %}

{{ forms.selectField({
    label: 'Country'|t('craft-google-location'),
    id: name~'-country',
    name: name~'[country]',
    options: countries,
    value: value.country
})}}

{{ forms.textField({
    label: 'Some Field',
    instructions: 'Enter some text here.',
    id: name~'-lat',
    name: name~'[lat]',
    value: value.lat
})}}

{{ forms.textField({
    label: 'Some Field',
    instructions: 'Enter some text here.',
    id: name~'-lng',
    name: name~'[lng]',
    value: value.lng
})}}

<div id="{{ name }}-map" class="apt-google-location-map"></div>

<script>
    function AptCraftGoogleLocationInitMap() {
        $('body').trigger('apt-google-location-map-init');
    }
</script>
