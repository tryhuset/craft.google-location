{% import "_includes/forms" as forms %}

{{ forms.hidden({
    id: name,
    name: name,
    value: value|json_encode,
})}}

<input id="{{ name }}-search" class="apt-google-area-controls controls" type="text" placeholder="{{ 'Search places'|t('craft-google-location') }}">
<div id="{{ name }}-map" class="apt-google-area-map"></div>

<script>
    function AptCraftGoogleLocationInitMap() {
        $('body').trigger('apt-google-area-map-init');
    }
</script>
